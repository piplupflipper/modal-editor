## 下に置く
size 16x8 cursor 0,2 block
   |あいうえおかきく|
   | func f()       |
fx |vvvvvvvvvvvvvvvv|
   |                |
fx |vvvvvvvvvvvvvvvv|
   | long line that |
fx |vvvvvvvvvvvvvvvv|
   |  wraps         |
fx |vvvvvvvvvvvvvvvv|
   |line5           |
   | NOR 1,4-3  Top |
fx |SSSSSSSSSSSSSSSS|
   |                |

## 下に収まらなければ上に置く
size 16x8 cursor 5,2 block
   |あいうえおかきく|
   |li a            |
fx |  vvv           |
   |li b            |
fx |  vvv           |
   |li c            |
fx |  vvv           |
   |li d            |
fx |  vvv           |
   |line5           |
   | NORMA 6,3  Top |
fx |SSSSSSSSSSSSSSSS|
   |                |

## 行が収まらなければ残りの行数
size 16x8 cursor 1,0 block
   |あいうえおかきく|
   |line1           |
   | 1              |
fx |vvvvvvvvvvvvvvv |
   | 2              |
fx |vvvvvvvvvvvvvvv |
   | 3              |
fx |vvvvvvvvvvvvvvv |
   | （残り 4 行）  |
fx |vvvvvvvvvvvvvvv |
   | NORMA 2,1  Top |
fx |SSSSSSSSSSSSSSSS|
   |                |

