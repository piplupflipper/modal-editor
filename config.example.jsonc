// vi-imitation の設定の例（見た目）。
// $XDG_CONFIG_HOME/vi-imitation/config.jsonc（未設定なら ~/.config/vi-imitation/config.jsonc）に写して使う。
// 項目の説明は docs/usage.md の「見た目の設定」にある。
//
// 配色は、本体に同梱した iceberg（https://github.com/cocopon/iceberg.vim の暗い背景の色）を選び、その上に colors を重ねる。
// colors に書いたのは、端末の背景を見せる（背景を透過させる）前提の調整と、iceberg.vim に元の色が無い名前である。
// iceberg.vim から写した値と写した元は、internal/config/colors/iceberg.jsonc にある。
// 24 ビットの色を出せる端末で使う。
{
  "colorscheme": "iceberg",

  "colors": {
    // 端末の背景を透過させる前提の調整
    // iceberg の NonText（#242940）は透過した背景では見えないので、LineNr の文字の色（#444b71）を使う
    "nontext": { "fg": "#444b71" },
    // 浮かべる窓、メッセージ、印の列、タブの行のいまのタブには背景の色を付けない
    // （iceberg の背景の色が、透過した背景の上で帯に見えるため）。文字の色は iceberg と同じにする
    "popup": { "fg": "#c6c8d1" },
    "message.warning": { "fg": "#e27878" },
    "message.error": { "fg": "#e27878" },
    "tabline.selected": { "fg": "#9a9ca5" },
    "sign.diagnostic.error": { "fg": "#e27878" },
    "sign.diagnostic.warning": { "fg": "#e2a478" },
    "sign.diagnostic.info": { "fg": "#89b8c2" },
    "sign.diagnostic.hint": { "fg": "#6b7089" },

    // iceberg.vim に元の色が無い名前
    "statusline.mode": { "bold": true },
    // lightline の iceberg にコマンドラインのモードの色は無いので、ノーマルモードと同じ色にする
    "statusline.mode.commandline": { "fg": "#17171b", "bg": "#818596" },
    "popup.border": { "fg": "#6b7089" },
    "sign.executionPoint": { "fg": "#e2a478", "bold": true },
    "sign.breakpoint": { "fg": "#e27878" },
    "sign.breakpointUnverified": { "fg": "#6b7089" },
  },

  // 記号。端末の文字幅の設定（曖昧な幅の文字を 2 列にする設定）によっては、罫線と ● の列がずれる
  "symbols": {
    "popup.border": "╭─╮│╯─╰│",
    "sign.breakpoint": "●",
    "sign.breakpointUnverified": "○",
  },

  // ステータス行の並び
  "statusline": {
    "left": ["mode", "name", "modified", "readonly"],
    "right": ["recording", "filetype", "ruler", "position"],
  },
}
