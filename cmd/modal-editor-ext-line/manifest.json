{
  "id": "line",
  "command": "./modal-editor-ext-line",
  "activation": [
    { "on": "textObject", "id": "line.inner" },
    { "on": "textObject", "id": "line.around" }
  ],
  "contributes": {
    "textObjects": [
      { "id": "line.inner", "keys": "il", "description": "行の中身（行頭と行末の空白を除く）" },
      { "id": "line.around", "keys": "al", "description": "行の全体（行末の改行を含めない）" }
    ]
  }
}
