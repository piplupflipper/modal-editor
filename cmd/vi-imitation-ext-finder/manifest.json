{
  "id": "finder",
  "command": "./modal-editor-ext-finder",
  "activation": [
    { "on": "command", "id": "finder.files" },
    { "on": "command", "id": "finder.grep" },
    { "on": "command", "id": "finder.grepDir" },
    { "on": "command", "id": "finder.grepWord" },
    { "on": "command", "id": "finder.buffers" },
    { "on": "command", "id": "finder.lines" },
    { "on": "command", "id": "finder.keys" },
    { "on": "command", "id": "finder.commands" },
    { "on": "command", "id": "finder.registers" },
    { "on": "command", "id": "finder.jumps" },
    { "on": "command", "id": "finder.resume" }
  ],
  "contributes": {
    "commands": [
      { "id": "finder.files", "keys": "<Leader>ff", "description": "ファイルを探して開く" },
      { "id": "finder.grep", "keys": "<Leader>fg", "description": "作業ディレクトリの下を rg で検索する" },
      { "id": "finder.grepDir", "keys": "<Leader>f.", "description": "いまのファイルのディレクトリの下を rg で検索する" },
      { "id": "finder.grepWord", "keys": "<Leader>fw", "description": "カーソルの下の語を rg で検索する" },
      { "id": "finder.buffers", "keys": "<Leader>fb", "description": "タブを探して移る" },
      { "id": "finder.lines", "keys": "<Leader>fl", "description": "いまのバッファの行を探して移る" },
      { "id": "finder.keys", "keys": "<Leader>fk", "description": "キーの一覧を探す" },
      { "id": "finder.commands", "keys": "<Leader>fc", "description": "コマンドを探す" },
      { "id": "finder.registers", "keys": "<Leader>fr", "description": "レジスターと履歴を探して貼る" },
      { "id": "finder.jumps", "keys": "<Leader>fj", "description": "ジャンプリストを探して移る" },
      { "id": "finder.resume", "keys": "<Leader>fp", "description": "最後のファインダーを最後の入力で開き直す" }
    ]
  }
}
