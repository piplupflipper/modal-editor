{
  "id": "acp",
  "command": "./modal-editor-ext-acp",
  "activation": [
    { "on": "command", "id": "acp.prompt" },
    { "on": "command", "id": "acp.cancel" }
  ],
  "contributes": {
    "commands": [
      { "id": "acp.prompt", "description": "エージェントにプロンプトを送る（:acp.prompt <プロンプト>）" },
      { "id": "acp.cancel", "description": "処理中のプロンプトを取り消す" }
    ]
  }
}
