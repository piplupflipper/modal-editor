{
  "id": "treesitter",
  "command": "./vi-imitation-ext-treesitter",
  "activation": [
    { "on": "filetype", "pattern": "go" },
    { "on": "filetype", "pattern": "json" },
    { "on": "filetype", "pattern": "jsonc" }
  ],
  "contributes": {
    "textObjects": [
      { "id": "treesitter.function.around", "keys": "af", "description": "関数の全体（tree-sitter）" },
      { "id": "treesitter.function.inner", "keys": "if", "description": "関数の本体の内側（tree-sitter）" },
      { "id": "treesitter.class.around", "keys": "ac", "description": "型の宣言の全体（tree-sitter）" },
      { "id": "treesitter.class.inner", "keys": "ic", "description": "型の宣言の内側（tree-sitter）" },
      { "id": "treesitter.parameter.around", "keys": "aa", "description": "引数と区切りの ,（tree-sitter）" },
      { "id": "treesitter.parameter.inner", "keys": "ia", "description": "引数 1 つ（tree-sitter）" }
    ]
  }
}
